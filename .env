# .env
# متغیرهای عمومی
NODE_ENV=production
APP_NAME=React-Client
APP_PORT=3030
HOST_PORT=8000

# متغیرهای API
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_KEY=your-secret-api-key-12345
REACT_APP_ENV=production
REACT_APP_VERSION=1.0.0

# متغیرهای دیتابیس (مثال)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=admin
DB_PASSWORD=secure_password_123

# متغیرهای دیگر
REACT_APP_GOOGLE_MAPS_KEY=AIzaSy_Your_Key_Here
REACT_APP_SENTRY_DSN=https://your-sentry-dsn
REACT_APP_FEATURE_FLAG_NEW_DASHBOARD=true
REACT_APP_DEBUG_MODE=false